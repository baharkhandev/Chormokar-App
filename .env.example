# ─── API ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# ─── Media (Cloudflare R2) ───────────────────────────────────────────────────
# Public base URL that serves files from the R2 bucket.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.chormokar.com

# ─── Local dev convenience (NEVER enable in production) ───────────────────────
# Allows admin API calls without a token. Hard-disabled when NODE_ENV=production.
ADMIN_DEV_AUTO_AUTH=false
ADMIN_DEV_EMAIL=
ADMIN_DEV_PASSWORD=

# ─── Storefront revalidation ─────────────────────────────────────────────────
# Used to refresh the storefront cache right after an admin change.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001
REVALIDATE_SECRET=
